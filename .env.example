# Copy to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/twjp_prices
APP_ENV=development
APP_PORT=8000

# Exchange rate (JPY -> TWD). Override or fetch live from an API.
JPY_TO_TWD_RATE=0.218

# Optional: rate-limit scraper to avoid bans (seconds between requests)
SCRAPER_REQUEST_DELAY=1.5
