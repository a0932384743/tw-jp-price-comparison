# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/twjp_prices
APP_ENV=development
APP_PORT=8000

# Exchange rate (JPY -> TWD). Override or fetch live from an API.
JPY_TO_TWD_RATE=0.218

# Optional: rate-limit scraper to avoid bans (seconds between requests)
SCRAPER_REQUEST_DELAY=1.5
